{
  "name": "iarchieve-ads-admin-local",
  "main": "src/ads-admin-worker.mjs",
  "compatibility_date": "2025-10-01",
  "workers_dev": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/ads/*",
      "/ads/admin",
      "/ads/admin/",
      "/ads/admin.html"
    ]
  }
}
